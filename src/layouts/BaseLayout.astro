---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';
// Resolved to the hashed build URL so the preload never goes stale.
// Without it the browser can't discover the font until the stylesheet has
// downloaded and parsed — a three-hop chain in front of the LCP heading.
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { SITE } from '../data/site';
import { SERVICES } from '../data/services';
import type { QA } from '../data/faq';
import type { Lang } from '../i18n/utils';

export interface Crumb {
  name: string;
  /** Absolute path, e.g. "/es/blog/" */
  path: string;
}

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Path of this page, e.g. "/es/" — used for canonical & og:url */
  path: string;
  /** Exclude from search indexing (e.g. the 404 page) */
  noindex?: boolean;
  /**
   * Spanish/English counterpart paths for hreflang (default: home).
   * Pass `null` when no counterpart exists (e.g. a post only written in one
   * language) so we never point Google at a page that isn't a translation.
   */
  esHref?: string | null;
  enHref?: string | null;
  /** Social preview image path (defaults to the site-wide one) */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Breadcrumb trail *after* the home item. Renders visibly + as JSON-LD. */
  breadcrumbs?: Crumb[];
  /** Q&A rendered on this page — turns the page node into a FAQPage. */
  faqs?: QA[];
  /** Article metadata; emits a BlogPosting node in the graph. */
  article?: {
    published: Date;
    modified?: Date;
    section?: string;
    tags?: string[];
    /** Estimated word count, improves Article parsing */
    wordCount?: number;
  };
  /** Extra JSON-LD nodes merged into the @graph (e.g. Service, ItemList) */
  extraJsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  lang,
  path,
  noindex = false,
  esHref = '/es/',
  enHref = '/en/',
  ogImage = '/og-image.png',
  ogType = 'website',
  breadcrumbs = [],
  faqs = [],
  article,
  extraJsonLd = [],
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const url = (p: string) => new URL(p, site).toString();

const canonical = url(path);
const esUrl = esHref ? url(esHref) : null;
const enUrl = enHref ? url(enHref) : null;
const ogImageUrl = url(ogImage);
const ogLocale = lang === 'es' ? 'es_PE' : 'en_US';
const inLanguage = lang === 'es' ? 'es-PE' : 'en-US';

/* ── Stable @id-s. Every entity is declared once and referenced everywhere
      else, so Google reads one business, not one per page. ───────────────── */
const ID = {
  org: url('/#organization'),
  logo: url('/#logo'),
  founder: url('/#founder'),
  business: url('/#business'),
  website: url('/#website'),
  page: `${canonical}#webpage`,
  breadcrumb: `${canonical}#breadcrumb`,
  article: `${canonical}#article`,
};

const sameAs = SITE.sameAs.filter(Boolean);
const founderSameAs = SITE.founder.sameAs.filter(Boolean);

const logoLd = {
  '@type': 'ImageObject',
  '@id': ID.logo,
  url: url('/favicon.svg'),
  contentUrl: url('/favicon.svg'),
  caption: SITE.name,
};

const founderLd = {
  '@type': 'Person',
  '@id': ID.founder,
  name: SITE.founder.name,
  jobTitle: SITE.founder.jobTitle[lang],
  url: url(`/${lang}/`),
  worksFor: { '@id': ID.org },
  knowsLanguage: ['es', 'en'],
  ...(founderSameAs.length ? { sameAs: founderSameAs } : {}),
};

const orgLd = {
  '@type': 'Organization',
  '@id': ID.org,
  name: SITE.name,
  // Variants people actually type when searching the brand.
  alternateName: [SITE.shortName, 'Mathyus Solutions', 'Mathyu Solutions'],
  url: SITE.url,
  logo: { '@id': ID.logo },
  image: { '@id': ID.logo },
  email: SITE.email,
  telephone: SITE.phoneE164,
  taxID: SITE.ruc,
  vatID: SITE.ruc,
  foundingDate: String(SITE.foundingYear),
  founder: { '@id': ID.founder },
  numberOfEmployees: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 10 },
  knowsAbout: SITE.knowsAbout,
  knowsLanguage: ['es', 'en'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    addressCountry: SITE.country,
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: SITE.phoneE164,
      email: SITE.email,
      contactType: 'sales',
      areaServed: ['PE', 'US', 'ES', 'MX', 'CO', 'CL'],
      availableLanguage: ['Spanish', 'English'],
    },
  ],
  ...(sameAs.length ? { sameAs } : {}),
};

/* One LocalBusiness entity for the whole site (previously duplicated per page). */
const businessLd = {
  '@type': 'ProfessionalService',
  '@id': ID.business,
  name: SITE.name,
  description,
  url: url(`/${lang}/`),
  image: ogImageUrl,
  logo: { '@id': ID.logo },
  telephone: SITE.phoneE164,
  email: SITE.email,
  priceRange: 'S/ 2,500 - S/ 60,000',
  currenciesAccepted: 'PEN, USD',
  paymentAccepted: 'Transferencia bancaria, Tarjeta de crédito',
  parentOrganization: { '@id': ID.org },
  founder: { '@id': ID.founder },
  areaServed: SITE.areaServed.map((n) => ({ '@type': 'AdministrativeArea', name: n })),
  serviceType: [
    'Web Development',
    'Ecommerce Development',
    'Mobile App Development',
    'AI Applications',
    'DevOps',
    'Cloud Engineering',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    addressCountry: SITE.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: SITE.hours.days,
      opens: SITE.hours.opens,
      closes: SITE.hours.closes,
    },
  ],
  // Every service we sell, linked to the page that describes it.
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: lang === 'es' ? 'Servicios de software' : 'Software services',
    itemListElement: SERVICES.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s[lang].h1,
        description: s[lang].description,
        url: url(`/${lang}/${s[lang].slug}/`),
        provider: { '@id': ID.org },
      },
      priceSpecification: {
        '@type': 'PriceSpecification',
        priceCurrency: lang === 'es' ? 'PEN' : 'USD',
        minPrice: lang === 'es' ? 2500 : 1000,
      },
      availability: 'https://schema.org/InStock',
      areaServed: 'PE',
    })),
  },
  ...(sameAs.length ? { sameAs } : {}),
};

const webSiteLd = {
  '@type': 'WebSite',
  '@id': ID.website,
  name: SITE.name,
  url: SITE.url,
  inLanguage,
  publisher: { '@id': ID.org },
};

/* Breadcrumb always starts at the language home. */
const crumbs: Crumb[] = [
  { name: lang === 'es' ? 'Inicio' : 'Home', path: `/${lang}/` },
  ...breadcrumbs,
];
const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  '@id': ID.breadcrumb,
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: url(c.path),
  })),
};

const pageLd: Record<string, unknown> = {
  '@type': faqs.length ? ['WebPage', 'FAQPage'] : 'WebPage',
  '@id': ID.page,
  url: canonical,
  name: title,
  description,
  inLanguage,
  isPartOf: { '@id': ID.website },
  about: { '@id': ID.org },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
  breadcrumb: { '@id': ID.breadcrumb },
  ...(faqs.length
    ? {
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : {}),
  ...(article
    ? {
        datePublished: article.published.toISOString(),
        dateModified: (article.modified ?? article.published).toISOString(),
      }
    : {}),
};

const articleLd = article
  ? {
      '@type': 'BlogPosting',
      '@id': ID.article,
      headline: title.slice(0, 110),
      description,
      inLanguage,
      mainEntityOfPage: { '@id': ID.page },
      isPartOf: { '@id': ID.page },
      author: { '@id': ID.founder },
      publisher: { '@id': ID.org },
      image: [ogImageUrl],
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      ...(article.section ? { articleSection: article.section } : {}),
      ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
      ...(article.wordCount ? { wordCount: article.wordCount } : {}),
    }
  : null;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    orgLd,
    logoLd,
    founderLd,
    businessLd,
    webSiteLd,
    breadcrumbLd,
    pageLd,
    ...(articleLd ? [articleLd] : []),
    ...extraJsonLd,
  ],
};
---

<!doctype html>
<html lang={lang} data-theme="dark" data-audience="biz">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- FOUC prevention: apply theme & audience before first paint -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('ms-theme') || 'dark';
          var a = localStorage.getItem('ms-aud') || 'biz';
          var r = document.documentElement;
          r.classList.add('js');
          r.setAttribute('data-theme', t);
          r.setAttribute('data-audience', a);
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#11161b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />

    <!-- hreflang: generic language tags catch all of LATAM/US, regional ones
         reinforce the primary markets. Only emitted when the page exists. -->
    {esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    {esUrl && <link rel="alternate" hreflang="es-PE" href={esUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {enUrl && <link rel="alternate" hreflang="en-US" href={enUrl} />}
    <link rel="alternate" hreflang="x-default" href={esUrl ?? canonical} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — Blog (${lang === 'es' ? 'español' : 'English'})`}
      href={url(`/${lang}/blog/rss.xml`)}
    />

    <!-- Fonts: the H1 and body copy both paint from these, so start fetching
         them in parallel with the stylesheet rather than after it. -->
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${description}`} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_PE'} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && (
      <meta
        property="article:modified_time"
        content={(article.modified ?? article.published).toISOString()}
      />
    )}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Local SEO hints -->
    <meta name="geo.region" content="PE-LIM" />
    <meta name="geo.placename" content={`${SITE.city}, ${SITE.countryName}`} />
    <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
    <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />

    <!-- Structured data: one linked graph for the whole page -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a href="#top" class="visually-hidden">Skip to content</a>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
