---
import { otherLang, type Lang } from '../../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const target = otherLang(lang);
const href = `/${target}/`;
const label = target.toUpperCase();
const title = lang === 'es' ? 'Switch to English' : 'Cambiar a español';
---
{/* Shows only the language you'd switch *to* — "ES / EN" read as a status
    label and took twice the width in an already crowded bar. */}
<a class="icon-btn" id="lang-toggle" href={href} title={title} hreflang={target} aria-label={title}>
  <strong>{label}</strong>
</a>
