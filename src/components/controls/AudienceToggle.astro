---
import { translator, type Lang } from '../../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = translator(lang, 'tech');
---
<div class="aud-toggle" id="aud-toggle" role="group" aria-label={lang === 'es' ? 'Audiencia' : 'Audience'}>
  <button type="button" data-aud="biz" aria-pressed="true">{tt('aud.biz')}</button>
  <button type="button" data-aud="tech" aria-pressed="false">{tt('aud.tech')}</button>
</div>
