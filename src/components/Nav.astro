---
import { translator, type Lang } from '../i18n/utils';
import { casesIndexPath } from '../data/cases';
import AudienceToggle from './controls/AudienceToggle.astro';
import LangToggle from './controls/LangToggle.astro';
import ThemeToggle from './controls/ThemeToggle.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = translator(lang, 'biz');
const home = `/${lang}/`;
// "Cómo trabajamos" / Process is deliberately not in the top nav: it is
// reassurance copy, not navigation, and the long label was what pushed the bar
// onto two lines. It still lives in the footer and on the landing page.
//
// On the landing page keep bare hashes so smooth-scroll handles them; anywhere
// else prefix with the home path so every page links back into the main
// sections (good for users, and it spreads internal link equity to the home).
const isHome = Astro.url.pathname === home;
const anchor = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);
---
<nav class="nav" id="site-nav">
  <div class="wrap nav-inner">
    <a class="brand" href={home} aria-label="Mathyu's Solutions">
      <span class="brand-mark"><span class="br">&lt;</span>MS<span class="br">&gt;</span></span>
      <span class="brand-name">Mathyu's <span class="dim">Solutions</span></span>
    </a>
    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-label="Menú"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>
    <div class="nav-collapse" id="nav-menu">
      <div class="nav-links">
        <a href={anchor('services')} data-i18n="nav.services">{tt('nav.services')}</a>
        <a href={casesIndexPath(lang)} data-i18n="nav.cases">{tt('nav.cases')}</a>
        <a href={anchor('pricing')} data-i18n="nav.pricing">{tt('nav.pricing')}</a>
        <a href={`${home}blog/`}>Blog</a>
        <a href={anchor('contact')} data-i18n="nav.contact">{tt('nav.contact')}</a>
      </div>
      <div class="nav-actions">
        <AudienceToggle lang={lang} />
        <LangToggle lang={lang} />
        <ThemeToggle />
        <button class="btn nav-cta" type="button" data-modal-open>
          <span data-i18n="nav.cta">{tt('nav.cta')}</span>
          <span class="arr" aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</nav>
