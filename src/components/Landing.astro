---
import type { Lang } from '../i18n/utils';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Process from './Process.astro';
import Cases from './Cases.astro';
import Testimonials from './Testimonials.astro';
import Pricing from './Pricing.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import ContactModal from './ContactModal.astro';
import SiteBehavior from './SiteBehavior.astro';
import Motion from './Motion.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Nav lang={lang} />
<main>
  <Hero lang={lang} />
  <Services lang={lang} />
  <Process lang={lang} />
  <Cases lang={lang} />
  <Testimonials lang={lang} />
  <Pricing lang={lang} />
  <Faq lang={lang} />
  <Contact lang={lang} />
</main>
<Footer lang={lang} />
<ContactModal lang={lang} />
<SiteBehavior lang={lang} />
<Motion />
