---
import type { Lang } from '../i18n/utils';
import { FAQ } from '../data/faq';

interface Props { lang: Lang }
const { lang } = Astro.props;
const faq = FAQ[lang];
// FAQPage structured data lives in BaseLayout's @graph (the page node becomes
// a WebPage + FAQPage), so it stays linked to the rest of the entities.
---
<section class="block" id="faq">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow mono">{faq.eyebrow}</span>
        <h2>{faq.title}</h2>
      </div>
    </div>
    <div class="faq reveal">
      {faq.items.map((it) => (
        <details class="faq-item">
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
