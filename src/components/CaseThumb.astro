---
/**
 * Case-study artwork, extracted from Cases.astro so the homepage grid and the
 * dedicated case pages render the same illustration.
 *
 * Note: the gradient ids inside each SVG are global to the document, so render
 * any given case at most once per page.
 */
import type { CaseId } from '../data/cases';

interface Props { id: CaseId }
const { id } = Astro.props;
---
{id === 'twenty' && (
  <svg viewBox="0 0 500 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="twn-bg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#1a1a1a" />
        <stop offset="100%" stop-color="#050505" />
      </linearGradient>
      <radialGradient id="twn-glow" cx="0.5" cy="0.42" r="0.5">
        <stop offset="0%" stop-color="#ffdd00" stop-opacity="0.22" />
        <stop offset="100%" stop-color="#ffdd00" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="500" height="300" fill="url(#twn-bg)" />
    <rect width="500" height="300" fill="url(#twn-glow)" />
    <g stroke="#fff" stroke-opacity="0.05" stroke-width="1">
      <line x1="0" y1="60" x2="500" y2="60" />
      <line x1="0" y1="120" x2="500" y2="120" />
      <line x1="0" y1="180" x2="500" y2="180" />
      <line x1="0" y1="240" x2="500" y2="240" />
    </g>
    <g transform="translate(250 132)">
      <path d="M-30 -62 Q 0 -42 30 -62 L 80 -42 L 104 0 L 72 14 L 62 -6 L 62 72 L -62 72 L -62 -6 L -72 14 L -104 0 L -80 -42 Z" fill="#141414" stroke="#f2f2f2" stroke-width="3" stroke-linejoin="round" />
      <path d="M-30 -62 Q 0 -42 30 -62" fill="none" stroke="#f2f2f2" stroke-width="6" stroke-linecap="round" />
      <text x="0" y="34" text-anchor="middle" fill="#ffdd00" font-family="Bricolage Grotesque Variable, serif" font-size="50" font-weight="800">20</text>
      <path d="M80 -42 Q 98 -54 111 -28" fill="none" stroke="#ffdd00" stroke-width="1.5" />
      <g transform="translate(118 -28) rotate(18)">
        <rect x="-14" y="-10" width="46" height="26" rx="4" fill="#ffdd00" />
        <circle cx="-6" cy="3" r="3" fill="#0d0d0d" />
        <text x="13" y="8" text-anchor="middle" fill="#0d0d0d" font-family="JetBrains Mono Variable, monospace" font-size="12" font-weight="700">S/</text>
      </g>
    </g>
    <text x="250" y="262" text-anchor="middle" fill="#fff" opacity="0.9" font-family="Bricolage Grotesque Variable, serif" font-size="22" font-weight="800" letter-spacing="8">TWENTY</text>
  </svg>
)}

{id === 'ciclo' && (
  <svg viewBox="0 0 500 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="ciclo-bg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#1d3a2a" />
        <stop offset="100%" stop-color="#0f1f17" />
      </linearGradient>
      <radialGradient id="ciclo-glow" cx="0.7" cy="0.3" r="0.6">
        <stop offset="0%" stop-color="#7fd99a" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#7fd99a" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="500" height="300" fill="url(#ciclo-bg)" />
    <rect width="500" height="300" fill="url(#ciclo-glow)" />
    <g transform="translate(250 150)">
      <circle r="78" fill="none" stroke="#7fd99a" stroke-opacity="0.22" stroke-width="1" />
      <circle r="55" fill="none" stroke="#7fd99a" stroke-opacity="0.35" stroke-width="1.5" />
      <g stroke="#a8eebc" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path d="M-30 -20 A 36 36 0 0 1 30 -20" />
        <polyline points="30,-32 30,-20 18,-20" />
        <path d="M30 20 A 36 36 0 0 1 -30 20" />
        <polyline points="-30,32 -30,20 -18,20" />
      </g>
      <text x="0" y="100" text-anchor="middle" fill="#a8eebc" font-family="JetBrains Mono Variable, monospace" font-size="20" font-weight="700" letter-spacing="6">CICLO</text>
    </g>
  </svg>
)}

{id === 'parco' && (
  <svg viewBox="0 0 500 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="pdc-bg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#3a2a4d" />
        <stop offset="50%" stop-color="#7d3b6b" />
        <stop offset="100%" stop-color="#c66a3a" />
      </linearGradient>
      <radialGradient id="pdc-glow" cx="0.3" cy="0.4" r="0.6">
        <stop offset="0%" stop-color="#ffd28a" stop-opacity="0.45" />
        <stop offset="100%" stop-color="#ffd28a" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="500" height="300" fill="url(#pdc-bg)" />
    <rect width="500" height="300" fill="url(#pdc-glow)" />
    <g transform="translate(250 145)" fill="#ffd28a" opacity="0.92">
      <ellipse cx="-32" cy="-8" rx="38" ry="32" transform="rotate(-22 -32 -8)" />
      <ellipse cx="32" cy="-8" rx="38" ry="32" transform="rotate(22 32 -8)" />
      <ellipse cx="-26" cy="24" rx="24" ry="20" transform="rotate(-30 -26 24)" />
      <ellipse cx="26" cy="24" rx="24" ry="20" transform="rotate(30 26 24)" />
      <rect x="-2" y="-30" width="4" height="60" rx="2" fill="#1a0f22" />
      <circle cx="-7" cy="-32" r="3" fill="#1a0f22" />
      <circle cx="7" cy="-32" r="3" fill="#1a0f22" />
      <g fill="#1a0f22" opacity="0.45">
        <circle cx="-32" cy="-8" r="6" />
        <circle cx="32" cy="-8" r="6" />
      </g>
    </g>
    <text x="250" y="245" text-anchor="middle" fill="#fff" opacity="0.85" font-family="Bricolage Grotesque Variable, serif" font-style="italic" font-size="22" font-weight="500">Parco dei Colori</text>
  </svg>
)}

{id === 'calarm' && (
  <svg viewBox="0 0 500 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="cal-bg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#0a1834" />
        <stop offset="100%" stop-color="#1c3a7a" />
      </linearGradient>
      <radialGradient id="cal-glow" cx="0.5" cy="0.45" r="0.55">
        <stop offset="0%" stop-color="#ffd66b" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#ffd66b" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="500" height="300" fill="url(#cal-bg)" />
    <rect width="500" height="300" fill="url(#cal-glow)" />
    <g transform="translate(250 140)">
      <circle r="78" fill="#fff" opacity="0.96" />
      <circle r="78" fill="none" stroke="#0a1834" stroke-width="3" />
      <path d="M-78 -50 L -56 -68 M 78 -50 L 56 -68" stroke="#fff" stroke-width="14" stroke-linecap="round" />
      <path d="M-78 -50 L -56 -68 M 78 -50 L 56 -68" stroke="#0a1834" stroke-width="6" stroke-linecap="round" />
      <g stroke="#0a1834" stroke-width="2" stroke-linecap="round">
        <line x1="0" y1="-66" x2="0" y2="-58" />
        <line x1="66" y1="0" x2="58" y2="0" />
        <line x1="0" y1="66" x2="0" y2="58" />
        <line x1="-66" y1="0" x2="-58" y2="0" />
      </g>
      <line x1="0" y1="0" x2="0" y2="-42" stroke="#0a1834" stroke-width="5" stroke-linecap="round" />
      <line x1="0" y1="0" x2="32" y2="14" stroke="#e8732a" stroke-width="4" stroke-linecap="round" />
      <circle r="6" fill="#e8732a" />
      <path d="M-50 70 L -40 92 M 50 70 L 40 92" stroke="#fff" stroke-width="10" stroke-linecap="round" />
    </g>
    <text x="250" y="265" text-anchor="middle" fill="#fff" opacity="0.85" font-family="Bricolage Grotesque Variable, serif" font-size="22" font-weight="600" letter-spacing="0.5">Calarm</text>
  </svg>
)}

{id === 'selvatici' && (
  <svg viewBox="0 0 500 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="selv-bg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#3a401c" />
        <stop offset="100%" stop-color="#767b37" />
      </linearGradient>
      <radialGradient id="selv-glow" cx="0.5" cy="0.4" r="0.42">
        <stop offset="0%" stop-color="#f8ce79" stop-opacity="0.34" />
        <stop offset="100%" stop-color="#f8ce79" stop-opacity="0" />
      </radialGradient>
      <g id="selv-ear">
        <path d="M0 0 C 2 -50 1 -100 0 -134" fill="none" stroke="#fbf6ec" stroke-width="3" stroke-linecap="round" />
        <g fill="#fbf6ec">
          <ellipse cx="-7" cy="-74" rx="5" ry="11" transform="rotate(-25 -7 -74)" />
          <ellipse cx="7" cy="-74" rx="5" ry="11" transform="rotate(25 7 -74)" />
          <ellipse cx="-7" cy="-91" rx="5" ry="11" transform="rotate(-25 -7 -91)" />
          <ellipse cx="7" cy="-91" rx="5" ry="11" transform="rotate(25 7 -91)" />
          <ellipse cx="-7" cy="-108" rx="5" ry="11" transform="rotate(-25 -7 -108)" />
          <ellipse cx="7" cy="-108" rx="5" ry="11" transform="rotate(25 7 -108)" />
          <ellipse cx="-6" cy="-124" rx="4.5" ry="10" transform="rotate(-25 -6 -124)" />
          <ellipse cx="6" cy="-124" rx="4.5" ry="10" transform="rotate(25 6 -124)" />
          <ellipse cx="0" cy="-140" rx="4.5" ry="10" />
        </g>
      </g>
    </defs>
    <rect width="500" height="300" fill="url(#selv-bg)" />
    <rect width="500" height="300" fill="url(#selv-glow)" />
    <circle cx="250" cy="112" r="70" fill="#f8ce79" opacity="0.28" />
    <circle cx="250" cy="112" r="92" fill="none" stroke="#f8ce79" stroke-opacity="0.3" stroke-width="1" />
    <use href="#selv-ear" transform="translate(250 220) rotate(-26)" />
    <use href="#selv-ear" transform="translate(250 220)" />
    <use href="#selv-ear" transform="translate(250 220) rotate(26)" />
    <g fill="#8e9f93">
      <path d="M250 214 C 230 206 214 208 202 218 C 218 224 236 222 250 214 Z" />
      <path d="M250 214 C 270 206 286 208 298 218 C 282 224 264 222 250 214 Z" />
    </g>
    <text x="250" y="262" text-anchor="middle" fill="#fbf6ec" opacity="0.92" font-family="Bricolage Grotesque Variable, serif" font-style="italic" font-size="22" font-weight="500">I Selvatici</text>
  </svg>
)}
