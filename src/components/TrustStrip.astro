---
import { translator, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = translator(lang, 'tech');
const tb = translator(lang, 'biz');

const techChips = ['AWS', 'Azure', 'GCP', 'Kubernetes', 'Terraform', 'React · Next.js', 'Swift · Kotlin', 'Python · Node', 'OpenAI · LangChain'];
const bizChips = ['trustBiz.c1', 'trustBiz.c2', 'trustBiz.c3', 'trustBiz.c4', 'trustBiz.c5', 'trustBiz.c6', 'trustBiz.c7', 'trustBiz.c8'].map((k) => tb(k));
---
<div class="wrap">
  <div class="trust tech-only" data-animate>
    <span>{tt('trust.label')}</span>
    <div class="trust-marquee">
      <div class="trust-track">
        {techChips.map((c) => <div class="chip">{c}</div>)}
        {techChips.map((c) => <div class="chip dup" aria-hidden="true">{c}</div>)}
      </div>
    </div>
  </div>
  <div class="trust biz-only" data-animate>
    <span>{tb('trustBiz.label')}</span>
    <div class="trust-marquee">
      <div class="trust-track">
        {bizChips.map((c) => <div class="chip">{c}</div>)}
        {bizChips.map((c) => <div class="chip dup" aria-hidden="true">{c}</div>)}
      </div>
    </div>
  </div>
</div>
