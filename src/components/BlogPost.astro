---
import { render } from 'astro:content';
import type { Lang } from '../i18n/utils';
import { SITE } from '../data/site';
import { BLOG_UI, formatDate, postHref, readingMinutes, type Post } from '../data/blog';
import { SERVICES } from '../data/services';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ContactModal from './ContactModal.astro';
import SiteBehavior from './SiteBehavior.astro';
import Motion from './Motion.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props { lang: Lang; post: Post; related: Post[] }
const { lang, post, related } = Astro.props;
const ui = BLOG_UI[lang];
const { Content, headings } = await render(post);

const waHref = `https://wa.me/${SITE.whatsapp}`;
const service = SERVICES.find((s) => s.id === post.data.service);

// Only H2s make a useful table of contents.
const toc = headings.filter((h) => h.depth === 2);
---
<Nav lang={lang} />
<main>
  <article class="post" id="top">
    <header class="hero blog-hero">
      <div class="wrap">
        <Breadcrumbs
          lang={lang}
          items={[
            { name: ui.navLabel, path: `/${lang}/blog/` },
            { name: post.data.heading, path: postHref(post) },
          ]}
        />
        <div class="post-card-meta mono" style="margin-top:22px;">
          <time datetime={post.data.pubDate.toISOString()}>
            {ui.published} {formatDate(post.data.pubDate, lang)}
          </time>
          <span>·</span>
          <span>{readingMinutes(post)} {ui.readingTime}</span>
          {post.data.updatedDate && (
            <>
              <span>·</span>
              <span>{ui.updated} {formatDate(post.data.updatedDate, lang)}</span>
            </>
          )}
        </div>
        <h1 style="font-size:clamp(32px,4.6vw,54px); margin:18px 0 22px; max-width:24ch;">
          {post.data.heading}
        </h1>
        <p class="lead" style="max-width:62ch;">{post.data.description}</p>
        <div class="post-card-tags" style="margin-top:24px;">
          {post.data.tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>
      </div>
    </header>

    <div class="wrap post-body">
      {toc.length > 2 && (
        <aside class="post-toc" aria-label={ui.toc}>
          {/* Deliberately not a heading: the article's H2s should be the only
              second-level items in the document outline. */}
          <p class="mono toc-label">{ui.toc}</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </aside>
      )}

      <div class="prose">
        <Content />

        {post.data.faqs.length > 0 && (
          <section class="post-faq">
            <h2>{ui.faqTitle}</h2>
            <div class="faq">
              {post.data.faqs.map((it) => (
                <details class="faq-item">
                  <summary>{it.q}</summary>
                  <p>{it.a}</p>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>

    <div class="wrap">
      <div class="blog-cta">
        <h2>{ui.ctaTitle}</h2>
        <p>{ui.ctaText}</p>
        <div class="hero-cta" style="justify-content:center;">
          <button class="btn" type="button" data-modal-open>
            <span>{ui.ctaButton}</span><span class="arr" aria-hidden="true">→</span>
          </button>
          <a class="btn btn-secondary" href={waHref} target="_blank" rel="noopener">{ui.ctaWhatsapp}</a>
        </div>
        {service && (
          <p class="blog-cta-link">
            {ui.relatedService}: <a href={`/${lang}/${service[lang].slug}/`}>{service[lang].h1}</a>
          </p>
        )}
      </div>

      {related.length > 0 && (
        <section class="block" style="padding-top:0;">
          <div class="section-head reveal" style="margin-bottom:28px;">
            <div><span class="eyebrow mono">{ui.more}</span></div>
          </div>
          <div class="post-list">
            {related.map((r) => (
              <article class="post-card">
                <a href={postHref(r)}>
                  <div class="post-card-meta mono">
                    <time datetime={r.data.pubDate.toISOString()}>
                      {formatDate(r.data.updatedDate ?? r.data.pubDate, lang)}
                    </time>
                    <span>·</span>
                    <span>{readingMinutes(r)} {ui.readingTime}</span>
                  </div>
                  <h3>{r.data.heading}</h3>
                  <p>{r.data.description}</p>
                </a>
              </article>
            ))}
          </div>
          <p style="margin-top:32px;">
            <a href={`/${lang}/blog/`} class="mono" style="color:var(--fg-dim); text-decoration:none; font-size:13px;">
              {ui.backToBlog}
            </a>
          </p>
        </section>
      )}
    </div>
  </article>
</main>
<Footer lang={lang} />
<ContactModal lang={lang} />
<SiteBehavior lang={lang} />
<Motion />
