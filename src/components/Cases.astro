---
import { translator, type Lang } from '../i18n/utils';
import { CASES, CASES_UI, casePath, casesIndexPath } from '../data/cases';
import CaseThumb from './CaseThumb.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tt = translator(lang, 'biz');
const ui = CASES_UI[lang];
---
<section class="block" id="cases">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow mono"><span data-i18n="case.eyebrow">{tt('case.eyebrow')}</span></span>
        <h2 data-i18n="case.title">{tt('case.title')}</h2>
      </div>
      <p class="desc" data-i18n="case.desc">{tt('case.desc')}</p>
    </div>

    <!-- Cards link to our own case page rather than straight out to the client:
         the click (and the link equity) stays on the site, and the live product
         is one click away from there. -->
    <div class="cases">
      {CASES.map((c) => (
        <a class="case reveal" href={casePath(c, lang)}>
          <div class="thumb">
            <div class="badge" data-i18n={c.badgeKey}>{tt(c.badgeKey)}</div>
            <div class="ext" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8" /></svg>
            </div>
            <CaseThumb id={c.id} />
          </div>
          <div class="body">
            <h3 class="case-title">{c.name}</h3>
            <p class="url">{c.urlLabel}</p>
            <p data-i18n={c.descKey}>{tt(c.descKey)}</p>
            <div class="meta">{c.tags.map((tag) => <span>{tag}</span>)}</div>
          </div>
        </a>
      ))}
    </div>

    <p class="cases-more reveal">
      <a href={casesIndexPath(lang)}>{ui.readCase} →</a>
    </p>
  </div>
</section>
