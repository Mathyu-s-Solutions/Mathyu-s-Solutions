---
import type { Lang } from '../i18n/utils';
import { SITE } from '../data/site';
import { CASES, CASES_UI, casePath, casesIndexPath, type CaseStudy } from '../data/cases';
import { SERVICES, SERVICE_SHORT } from '../data/services';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ContactModal from './ContactModal.astro';
import SiteBehavior from './SiteBehavior.astro';
import MotionLite from './MotionLite.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CaseThumb from './CaseThumb.astro';

interface Props { lang: Lang; study: CaseStudy }
const { lang, study } = Astro.props;
const ui = CASES_UI[lang];
const copy = study.page[lang];
const waHref = `https://wa.me/${SITE.whatsapp}`;
const service = SERVICES.find((s) => s.id === study.service);
const others = CASES.filter((c) => c.id !== study.id);
---
<Nav lang={lang} />
<main>
  <article>
    <header class="hero blog-hero" id="top">
      <div class="wrap">
        <Breadcrumbs
          lang={lang}
          items={[
            { name: ui.navLabel, path: casesIndexPath(lang) },
            { name: study.name, path: casePath(study, lang) },
          ]}
        />
        <div class="post-card-meta mono" style="margin-top:22px;">
          <span>{study.name}</span>
          <span>·</span>
          <span>{ui.year} {study.year}</span>
          <span>·</span>
          <span>{study.urlLabel}</span>
        </div>
        <h1 style="font-size:clamp(32px,4.6vw,54px); margin:18px 0 22px; max-width:22ch;">{copy.h1}</h1>
        <p class="lead" style="max-width:62ch;">{copy.summary}</p>
        <div class="hero-cta" style="margin-top:28px;">
          <a class="btn" href={study.href} target="_blank" rel="noopener">
            <span>{copy.visitLabel}</span><span class="arr" aria-hidden="true">→</span>
          </a>
          <button class="btn btn-secondary" type="button" data-modal-open>{ui.ctaButton}</button>
        </div>
      </div>
    </header>

    <div class="wrap">
      <div class="case-hero-art" aria-hidden="true">
        <CaseThumb id={study.id} />
      </div>

      <div class="case-grid">
        <div class="prose">
          <h2>{copy.contextTitle}</h2>
          <p>{copy.context}</p>

          <h2>{copy.deliveredTitle}</h2>
          <ul>
            {copy.delivered.map((item) => <li>{item}</li>)}
          </ul>

          {copy.results.length > 0 && (
            <>
              <h2>{copy.resultsTitle}</h2>
              <ul>
                {copy.results.map((item) => <li>{item}</li>)}
              </ul>
            </>
          )}

          {study.quote && (
            <blockquote>
              {study.quote[lang]}
              <footer class="case-quote-author">— {study.quote.author}, {study.quote.role}</footer>
            </blockquote>
          )}
        </div>

        <aside class="case-aside">
          <div class="case-facts">
            <p class="mono toc-label">{ui.stack}</p>
            <div class="post-card-tags" style="margin-top:0;">
              {study.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
            {service && (
              <p class="case-service">
                {ui.relatedService}<br />
                <a href={`/${lang}/${service[lang].slug}/`}>{SERVICE_SHORT[study.service][lang]} →</a>
              </p>
            )}
            <p class="case-service">
              <a href={study.href} target="_blank" rel="noopener">{copy.visitLabel} →</a>
            </p>
          </div>
        </aside>
      </div>

      <div class="blog-cta">
        <h2>{ui.ctaTitle}</h2>
        <p>{ui.ctaText}</p>
        <div class="hero-cta" style="justify-content:center;">
          <button class="btn" type="button" data-modal-open>
            <span>{ui.ctaButton}</span><span class="arr" aria-hidden="true">→</span>
          </button>
          <a class="btn btn-secondary" href={waHref} target="_blank" rel="noopener">{ui.ctaWhatsapp}</a>
        </div>
      </div>

      <section class="block" style="padding-top:64px;">
        <div class="section-head" style="margin-bottom:28px;">
          <div><span class="eyebrow mono">{ui.otherCases}</span></div>
        </div>
        <div class="cases">
          {others.map((c) => (
            <a class="case" href={casePath(c, lang)}>
              <div class="body">
                <h3 class="case-title">{c.name}</h3>
                <p class="url">{c.urlLabel}</p>
                <p>{c.page[lang].summary}</p>
                <div class="meta">{c.tags.map((tag) => <span>{tag}</span>)}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>
</main>
<Footer lang={lang} />
<ContactModal lang={lang} />
<SiteBehavior lang={lang} />
<MotionLite />
