---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Landing from '../../components/Landing.astro';

const lang = 'es' as const;
const title = "Mathyu's Solutions — Desarrollo de software, apps móviles, IA y cloud en Lima";
const description =
  'Consultora de software en Lima, Perú. Desarrollamos aplicaciones web, apps móviles iOS y Android, soluciones con IA, DevOps y cloud (AWS, Azure, GCP). De la idea al producto.';
---
<BaseLayout title={title} description={description} lang={lang} path="/es/">
  <Landing lang={lang} />
</BaseLayout>
