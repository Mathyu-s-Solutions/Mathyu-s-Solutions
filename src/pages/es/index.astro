---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Landing from '../../components/Landing.astro';
import { FAQ } from '../../data/faq';

const lang = 'es' as const;
// Keyword first, brand last: the head of the title carries the most weight and
// the brand is what people recognize in the SERP.
const title = "Consultora de software en Lima: web, apps e IA | Mathyu's Solutions";
const description =
  'Consultora de software en Lima, Perú. Desarrollamos páginas web, tiendas online, apps móviles iOS y Android, automatización con IA y cloud. Cotiza en menos de 24 h.';
---
<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/es/"
  faqs={FAQ[lang].items}
>
  <Landing lang={lang} />
</BaseLayout>
