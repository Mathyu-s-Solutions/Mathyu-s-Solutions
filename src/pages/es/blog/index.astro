---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import { BLOG_UI, getPosts } from '../../../data/blog';

const lang = 'es' as const;
const ui = BLOG_UI[lang];
const posts = await getPosts(lang);
const path = '/es/blog/';
---
<BaseLayout
  title={`${ui.title} — Mathyu's Solutions`}
  description={ui.description}
  lang={lang}
  path={path}
  esHref={path}
  enHref="/en/blog/"
  breadcrumbs={[{ name: ui.navLabel, path }]}
>
  <BlogIndex lang={lang} posts={posts} />
</BaseLayout>
