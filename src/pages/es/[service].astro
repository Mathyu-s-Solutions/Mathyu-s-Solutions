---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicePage from '../../components/ServicePage.astro';
import { SERVICES, SERVICE_SHORT, type ServicePageData } from '../../data/services';
import { SITE, abs } from '../../data/site';
import { getPosts, type Post } from '../../data/blog';

export async function getStaticPaths() {
  const posts = await getPosts('es');
  return SERVICES.map((service) => ({
    params: { service: service.es.slug },
    props: {
      service,
      // Articles that feed this service page — internal links Google follows
      // and readers actually click.
      posts: posts.filter((p) => p.data.service === service.id).slice(0, 3),
    },
  }));
}

const lang = 'es' as const;
const { service, posts } = Astro.props as { service: ServicePageData; posts: Post[] };
const loc = service.es;
const path = `/es/${loc.slug}/`;

const serviceLd = {
  '@type': 'Service',
  '@id': `${abs(path)}#service`,
  name: loc.h1,
  description: loc.description,
  serviceType: SERVICE_SHORT[service.id].es,
  provider: { '@id': abs('/#organization') },
  areaServed: SITE.areaServed.map((n) => ({ '@type': 'AdministrativeArea', name: n })),
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: abs(path),
    servicePhone: SITE.phoneE164,
    availableLanguage: ['es', 'en'],
  },
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'PriceSpecification',
      priceCurrency: 'PEN',
      minPrice: 2500,
      valueAddedTaxIncluded: false,
    },
    availability: 'https://schema.org/InStock',
    url: abs(path),
  },
  url: abs(path),
};
---
<BaseLayout
  title={loc.title}
  description={loc.description}
  lang={lang}
  path={path}
  esHref={path}
  enHref={`/en/${service.en.slug}/`}
  ogImage={`/og/${loc.slug}.png`}
  breadcrumbs={[{ name: SERVICE_SHORT[service.id].es, path }]}
  faqs={loc.faqs}
  extraJsonLd={[serviceLd]}
>
  <ServicePage service={service} lang={lang} posts={posts} />
</BaseLayout>
