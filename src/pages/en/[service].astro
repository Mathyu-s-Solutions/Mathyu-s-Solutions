---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicePage from '../../components/ServicePage.astro';
import { SERVICES, type ServicePageData } from '../../data/services';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { service: service.en.slug }, props: { service } }));
}

const lang = 'en' as const;
const { service } = Astro.props as { service: ServicePageData };
const loc = service.en;
const path = `/en/${loc.slug}/`;
const esHref = `/es/${service.es.slug}/`;
const enHref = `/en/${service.en.slug}/`;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: loc.h1,
  description: loc.description,
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  areaServed: ['PE', 'LATAM'],
  url: new URL(path, SITE.url).toString(),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/en/', SITE.url).toString() },
    { '@type': 'ListItem', position: 2, name: loc.h1, item: new URL(path, SITE.url).toString() },
  ],
};
---
<BaseLayout
  title={loc.title}
  description={loc.description}
  lang={lang}
  path={path}
  esHref={esHref}
  enHref={enHref}
  extraJsonLd={[serviceLd, breadcrumbLd]}
>
  <ServicePage service={service} lang={lang} />
</BaseLayout>
