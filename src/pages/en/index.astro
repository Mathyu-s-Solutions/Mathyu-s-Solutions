---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Landing from '../../components/Landing.astro';
import { FAQ } from '../../data/faq';

const lang = 'en' as const;
const title = "Software development company in Peru | Mathyu's Solutions";
const description =
  'Nearshore software consultancy in Lima, Peru. We build web platforms, iOS and Android apps, AI automation and cloud infrastructure (AWS, Azure, GCP). Quote in 24h.';
---
<BaseLayout
  title={title}
  description={description}
  lang={lang}
  path="/en/"
  ogImage="/og/home-en.png"
  faqs={FAQ[lang].items}
>
  <Landing lang={lang} />
</BaseLayout>
